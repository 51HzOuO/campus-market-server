.page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 导航栏 */
.nav-bar {
  background: linear-gradient(135deg, #faad14 0%, #e6a23c 100%);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 40rpx;
  color: #fff;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.nav-placeholder {
  width: 60rpx;
}

/* 举报列表 */
.report-list {
  padding: 20rpx;
}

.report-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.report-item.handled {
  opacity: 0.6;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.report-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #fff7e6;
  color: #faad14;
}

.report-time {
  font-size: 24rpx;
  color: #999;
}

.report-body {
  margin-bottom: 16rpx;
}

.report-info {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.report-label {
  color: #999;
}

.report-reason {
  color: #1a1a1a;
  font-weight: 500;
}

.report-value {
  color: #1a1a1a;
}

.report-content {
  color: #666;
  display: block;
  margin-top: 8rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.report-actions {
  display: flex;
  gap: 16rpx;
}

.btn-handle {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff7e6;
  color: #faad14;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-delete {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.loading-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}
