.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

.nav-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
}

/* 举报列表 */
.report-list {
  padding: 20rpx 24rpx;
}

.report-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.report-item.handled {
  opacity: 0.6;
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #eee;
}

.report-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background: #ff4d4f;
  color: #fff;
}

.report-item.handled .report-status {
  background: #07C160;
}

.report-time {
  font-size: 22rpx;
  color: #999;
}

.report-body {
  margin-bottom: 16rpx;
}

.report-info {
  display: flex;
  margin-bottom: 8rpx;
}

.report-label {
  font-size: 24rpx;
  color: #999;
  min-width: 140rpx;
}

.report-reason {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.report-value {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.report-content {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.report-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.btn-handle {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #07C160;
  color: #fff;
}

.btn-delete {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #ff4d4f;
  color: #fff;
}

.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
