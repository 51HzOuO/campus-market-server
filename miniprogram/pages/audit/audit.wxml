<view class="page">

  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-content">
      <view class="nav-back" bindtap="goBack">
        <text class="back-arrow">←</text>
      </view>
      <text class="nav-title">审核管理</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>
  <view style="height:{{navBarTotalHeight}}px"></view>

  <!-- 举报列表 -->
  <view class="report-list">
    <view class="report-item {{item.status === 1 ? 'handled' : ''}}" wx:for="{{reports}}" wx:key="id">
      <view class="report-header">
        <text class="report-status">{{item.status === 0 ? '待处理' : '已处理'}}</text>
        <text class="report-time">{{item.createTime}}</text>
      </view>
      <view class="report-body">
        <view class="report-info">
          <text class="report-label">举报原因：</text>
          <text class="report-reason">{{item.reason}}</text>
        </view>
        <view class="report-info">
          <text class="report-label">举报人：</text>
          <text class="report-value">{{item.reporterName || '未知'}}</text>
        </view>
        <view class="report-info" wx:if="{{item.postTitle}}">
          <text class="report-label">帖子标题：</text>
          <text class="report-value" bindtap="goPost" data-id="{{item.postId}}">{{item.postTitle}}</text>
        </view>
        <view class="report-info" wx:if="{{item.postContent}}">
          <text class="report-label">帖子内容：</text>
          <text class="report-content">{{item.postContent}}</text>
        </view>
      </view>
      <view class="report-actions" wx:if="{{item.status === 0}}">
        <view class="btn-handle" bindtap="handleReport" data-id="{{item.id}}">标记已处理</view>
        <view class="btn-delete" bindtap="deletePost" data-id="{{item.postId}}">删除帖子</view>
      </view>
    </view>
  </view>

  <view class="loading-more" wx:if="{{loading}}">加载中...</view>
  <view class="empty" wx:if="{{!loading && reports.length === 0}}">暂无举报</view>

</view>
