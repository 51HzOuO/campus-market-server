.page{min-height:100vh;background:#f4f1eb;padding:34rpx 24rpx 70rpx;color:#1e2925}.header{height:92rpx;display:flex;align-items:center;justify-content:space-between}.back{width:64rpx;font-size:58rpx;font-weight:300;line-height:1;color:#1d6b57}.eyebrow{display:block;color:#9a8d79;font-size:19rpx;letter-spacing:4rpx}.header-title{display:block;margin-top:5rpx;color:#1e2925;font-size:39rpx;font-weight:700}.header-mark{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;color:#c28b54;font-size:28rpx;background:#f0e1cf;border-radius:50%}.intro{color:#718078;font-size:25rpx;line-height:1.6;margin:4rpx 8rpx 24rpx}.picker{display:flex;align-items:center;background:#1d6b57;border-radius:14rpx;padding:22rpx 24rpx;margin-bottom:22rpx;color:#fff;box-shadow:0 9rpx 20rpx rgba(29,107,87,.18)}.picker-label{opacity:.72;font-size:22rpx;margin-right:18rpx}.picker-value{font-size:29rpx;font-weight:600;flex:1}.picker-arrow{font-size:32rpx;opacity:.8}.card{background:#fbfaf7;border:1rpx solid #e8e0d4;border-radius:14rpx;padding:24rpx;margin-bottom:16rpx;box-shadow:0 8rpx 22rpx rgba(48,55,48,.05)}.card-top{display:flex;align-items:center;justify-content:space-between}.type-chip{color:#1d6b57;background:#e4efe9;border-radius:20rpx;padding:6rpx 14rpx;font-size:21rpx}.record-id{color:#aaa398;font-size:22rpx}.title{font-size:31rpx;font-weight:700;color:#1e2925;margin-top:18rpx}.meta{font-size:25rpx;color:#718078;line-height:1.5;margin-top:12rpx}.time{font-size:22rpx;color:#aaa398;margin-top:14rpx}.actions{display:flex;gap:16rpx;margin-top:22rpx}.actions button{margin:0;flex:1;height:58rpx;line-height:58rpx;border-radius:29rpx;font-size:24rpx}.approve{background:#1d6b57;color:#fff}.reject{background:#f0e1cf;color:#9b633c}.empty,.loading{text-align:center;color:#a29a8e;padding:100rpx 0}
