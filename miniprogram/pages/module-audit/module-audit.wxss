.page{min-height:100vh;background:#f5f6f8;padding:24rpx}.header{height:80rpx;display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:600}.header text:first-child{font-size:52rpx;font-weight:300}.picker{background:#fff;border-radius:12rpx;padding:26rpx 30rpx;margin-bottom:20rpx;color:#333}.card{background:#fff;border-radius:14rpx;padding:26rpx;margin-bottom:18rpx}.title{font-size:32rpx;font-weight:600;color:#222}.meta{font-size:27rpx;color:#666;margin-top:14rpx}.time{font-size:23rpx;color:#aaa;margin-top:14rpx}.actions{display:flex;gap:20rpx;margin-top:22rpx}.actions button{margin:0}.empty,.loading{text-align:center;color:#999;padding:100rpx 0}
