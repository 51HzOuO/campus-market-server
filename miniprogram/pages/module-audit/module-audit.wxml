<view class="page">
  <view class="header"><text bindtap="goBack">‹</text><text>业务审核</text><view></view></view>
  <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="changeType"><view class="picker">{{types[typeIndex]}}　⌄</view></picker>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="title">{{item.title || '未命名内容'}}</view>
    <view class="meta">{{item.description || '暂无描述'}}</view>
    <view class="time">{{item.createTime}}</view>
    <view class="actions"><button size="mini" type="primary" data-id="{{item.id}}" data-status="1" bindtap="review">通过</button><button size="mini" type="warn" data-id="{{item.id}}" data-status="2" bindtap="review">驳回</button></view>
  </view>
  <view class="empty" wx:if="{{!loading && items.length === 0}}">暂无待审核内容</view>
</view>
