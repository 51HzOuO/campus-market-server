<view class="page"><view class="top"><text class="title">校园社团</text><button size="mini" type="primary" bindtap="goCreate">创建社团</button></view><view class="card" wx:for="{{clubs}}" wx:key="id" bindtap="detail" data-id="{{item.id}}"><view class="name">{{item.name}}</view><view class="desc">{{item.description}}</view><view class="meta">成员 {{item.memberCount || 0}} 人</view></view><view class="empty" wx:if="{{!loading && clubs.length === 0}}">暂无已通过审核的社团</view></view>
