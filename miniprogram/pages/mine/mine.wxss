.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部用户信息 ========== */
.user-header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 40rpx 24rpx 36rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #e8e8e8;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-right: 12rpx;
}

.role-badge {
  font-size: 22rpx;
  color: #4A90D9;
  background: #e8f0fe;
  border-radius: 4rpx;
  padding: 2rpx 12rpx;
  line-height: 1.5;
}

.user-id {
  font-size: 24rpx;
  color: #bbb;
}

/* ========== 功能菜单 ========== */
.menu-list {
  background: #fff;
  margin-bottom: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.admin-item {
  background: #f0f9ff;
}

.admin-item .menu-label {
  color: #07C160;
  font-weight: 500;
}

.login-btn {
  margin: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

/* ========== 退出登录 ========== */
.logout-btn {
  margin: 40rpx 24rpx 0;
  text-align: center;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #FF4D4F;
  font-weight: 500;
}

.page { background: #f4f1eb; }
.user-header { background: #1d6b57; padding: 54rpx 30rpx 46rpx; margin-bottom: 20rpx; }
.user-avatar { border: 5rpx solid rgba(255,255,255,.7); background: #dce9e1; }
.user-name, .user-id { color: #fff; }
.user-id { opacity: .72; }
.role-badge { background: rgba(255,255,255,.18) !important; color: #fff !important; border-radius: 8rpx; }
.login-btn { background: #1d6b57; border-radius: 10rpx; box-shadow: 0 7rpx 18rpx rgba(29,107,87,.18); }
.menu-list { margin: 0 24rpx 18rpx; border-radius: 10rpx; overflow: hidden; box-shadow: 0 5rpx 16rpx rgba(48,55,48,.05); }
.menu-item { background: #fbfaf7; padding: 31rpx 26rpx; border-bottom-color: #eee8de; }
.menu-label { color: #2d3934; }
.menu-arrow { color: #a6afa9; }
.admin-item { background: #e4efe9; }
.admin-item .menu-label { color: #1d6b57; }
.logout-btn { background: #fbfaf7; border-radius: 10rpx; color: #a24d44; }
