.page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 导航栏 */
.nav-bar {
  background: #fff;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-placeholder {
  width: 60rpx;
}

/* 帖子内容区 */
.post-section {
  background: #fff;
  padding: 30rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.post-user {
  flex: 1;
  min-width: 0;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.activity-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.meta-row {
  display: flex;
  align-items: center;
}

.post-time {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.module-tag {
  font-size: 22rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.post-body {
  margin-bottom: 24rpx;
}

.post-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

/* 图片九宫格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.grid-image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

/* 统计行 */
.stats-row {
  display: flex;
  align-items: center;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.stat-item {
  font-size: 24rpx;
  color: #999;
}

.report-text-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  margin-left: auto;
  padding: 4rpx 16rpx;
  background: #fff1f0;
  border-radius: 8rpx;
}

/* 分割线 */
.divider {
  height: 20rpx;
  background: #f5f7fa;
}

/* 评论列表 */
.comment-section {
  background: #fff;
  padding: 30rpx;
}

.comment-header {
  margin-bottom: 24rpx;
}

.comment-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.comment-item {
  display: flex;
  margin-bottom: 24rpx;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-user-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-right: 16rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
}

.comment-actions {
  margin-top: 8rpx;
}

.comment-reply {
  font-size: 24rpx;
  color: #07c160;
}

.comment-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.like-icon {
  font-size: 36rpx;
}

.like-num {
  font-size: 26rpx;
  color: #666;
}

.like-btn.liked .like-num {
  color: #ff4d4f;
}

.comment-input-wrap {
  flex: 1;
}

.comment-input {
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background: #f0f0f0;
  color: #999;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.send-btn.active {
  background: #07c160;
  color: #fff;
}

/* 举报弹窗 */
.report-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.report-dialog {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.report-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  display: block;
  margin-bottom: 30rpx;
}

.report-option {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #f5f5f5;
}

.report-option.selected {
  background: rgba(7, 193, 96, 0.1);
  color: #07c160;
  font-weight: 500;
}

.report-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.report-cancel {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.report-confirm {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}
