.page{min-height:100vh;background:#f5f6f8;padding:24rpx;box-sizing:border-box;color:#222}.form-card{background:#fff;border-radius:18rpx;padding:28rpx 24rpx}.label{font-size:27rpx;font-weight:600;margin:8rpx 0 14rpx}.input,.textarea{box-sizing:border-box;width:100%;background:#f7f8fa;border-radius:10rpx;padding:18rpx 20rpx;font-size:28rpx;margin-bottom:22rpx}.textarea{height:180rpx}.gap{margin-top:-10rpx}.row{display:flex;gap:18rpx}.number-box{display:flex;align-items:center;flex:1;background:#f7f8fa;border-radius:10rpx;padding:0 18rpx;margin-bottom:14rpx}.number-box input{min-width:0;flex:1;padding:18rpx 0;font-size:28rpx}.number-box text{color:#888;font-size:25rpx}.urgent-row{display:flex;align-items:center;font-size:27rpx;color:#555;padding:14rpx 0}.checkbox{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;border:2rpx solid #bbb;border-radius:6rpx;margin-right:12rpx;color:#fff}.checkbox.checked{background:#07c160;border-color:#07c160}.price-box{display:flex;justify-content:space-between;align-items:center;background:#effaf3;border-radius:12rpx;margin:16rpx 0 26rpx;padding:20rpx;font-size:28rpx;color:#4f8d66}.price-box .price{font-size:42rpx;font-weight:600;color:#f06a32}.tip{font-size:24rpx;color:#999;padding:22rpx 8rpx}.submit{height:92rpx;line-height:92rpx;background:#07c160;color:#fff;border-radius:46rpx;font-size:30rpx}.submit.disabled{opacity:.6}
