.page{min-height:100vh;background:#f5f6f8;padding-bottom:130rpx}.gallery{height:560rpx;background:#eee}.gallery-img{width:100%;height:100%}.content{background:#fff;padding:30rpx 28rpx}.price{font-size:44rpx;color:#ef6a43;font-weight:700}.title{display:block;font-size:36rpx;font-weight:600;color:#222;margin:16rpx 0}.seller-row,.info{display:flex;justify-content:space-between;color:#888;font-size:25rpx}.line{height:1rpx;background:#eee;margin:26rpx 0}.label{display:block;color:#555;font-size:27rpx;font-weight:600;margin-bottom:12rpx}.description{display:block;color:#444;line-height:1.7;font-size:28rpx;white-space:pre-wrap}.info{padding:10rpx 0}.status{margin-top:24rpx;color:#2dbe9a;font-size:24rpx}.bottom{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #eee}.bottom button{flex:1;height:78rpx;line-height:78rpx;border-radius:40rpx;font-size:28rpx}.buy{background:#2dbe9a;color:#fff}.off{background:#f2f2f2;color:#666}.empty{text-align:center;color:#aaa;padding:160rpx 0}
