<view class="page">
  <view class="tabs">
    <view class="tab {{scope === 'available' ? 'active' : ''}}" data-scope="available" bindtap="switchScope">找人帮忙</view>
    <view class="tab {{scope === 'mine' ? 'active' : ''}}" data-scope="mine" bindtap="switchScope">我的订单</view>
  </view>

  <view class="notice">费用按距离、重量自动计算，接单后由发布者确认支付。</view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">{{emptyText}}</view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="order-head">
      <view class="title-wrap">
        <text class="urgent" wx:if="{{item.urgent === 1}}">加急</text>
        <text class="order-title">{{item.title}}</text>
      </view>
      <text class="price">¥{{item.priceText}}</text>
    </view>
    <text class="description">{{item.description}}</text>
    <view class="route"><text class="dot from"></text><text>{{item.pickupLocation}}</text></view>
    <view class="line"></view>
    <view class="route"><text class="dot to"></text><text>{{item.deliveryLocation}}</text></view>
    <view class="order-foot">
      <text>{{item.distanceKm}}km · {{item.weightKg}}kg · {{item.timeText}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
  </view>

  <view class="fab" bindtap="goCreate">＋</view>
</view>
