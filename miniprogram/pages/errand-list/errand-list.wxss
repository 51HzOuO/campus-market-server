.page{min-height:100vh;background:#f5f6f8;padding:24rpx 24rpx 140rpx;box-sizing:border-box;color:#222}.tabs{display:flex;background:#fff;border-radius:16rpx;padding:6rpx;margin-bottom:18rpx}.tab{flex:1;text-align:center;padding:18rpx 0;color:#888;font-size:30rpx}.tab.active{color:#07c160;font-weight:600;border-bottom:4rpx solid #07c160}.notice{background:#effaf3;color:#4f8d66;border-radius:12rpx;padding:18rpx 20rpx;font-size:24rpx;margin-bottom:18rpx}.loading,.empty{text-align:center;color:#999;padding:100rpx 0;font-size:28rpx}.order-card{background:#fff;border-radius:18rpx;padding:24rpx;margin-bottom:18rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.03)}.order-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}.title-wrap{display:flex;align-items:center;min-width:0}.order-title{font-weight:600;font-size:32rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.urgent{font-size:21rpx;color:#f05b4f;border:1rpx solid #f05b4f;border-radius:6rpx;padding:2rpx 8rpx;margin-right:10rpx}.price{color:#f06a32;font-size:34rpx;font-weight:600}.description{display:block;color:#666;font-size:26rpx;line-height:1.5;margin-bottom:18rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.route{display:flex;align-items:center;font-size:27rpx;color:#444}.dot{width:14rpx;height:14rpx;border-radius:50%;margin:0 14rpx 0 4rpx}.dot.from{background:#07c160}.dot.to{background:#4c8dff}.line{height:22rpx;border-left:2rpx dashed #ccd3dc;margin-left:10rpx}.order-foot{border-top:1rpx solid #f1f1f1;margin-top:18rpx;padding-top:16rpx;display:flex;justify-content:space-between;color:#999;font-size:23rpx}.status{color:#07c160}.fab{position:fixed;right:40rpx;bottom:70rpx;width:104rpx;height:104rpx;line-height:96rpx;text-align:center;border-radius:50%;background:#07c160;color:#fff;font-size:60rpx;box-shadow:0 8rpx 24rpx rgba(7,193,96,.3)}
