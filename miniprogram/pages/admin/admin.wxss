.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.06);
}

.nav-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.nav-placeholder {
  width: 60rpx;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #07C160;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

/* 数据统计 */
.stats-section {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 20rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 用户列表 */
.list-section {
  padding: 20rpx 24rpx;
}

.user-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.user-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.btn-ban {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.btn-ban.ban {
  background: #ff4d4f;
  color: #fff;
}

.btn-ban.unban {
  background: #07C160;
  color: #fff;
}

/* 帖子列表 */
.post-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.post-info {
  margin-bottom: 12rpx;
}

.post-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.post-meta {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-actions {
  display: flex;
  gap: 16rpx;
}

.btn-top {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #eee;
  color: #666;
}

.btn-top.active {
  background: #07C160;
  color: #fff;
}

.btn-delete {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #ff4d4f;
  color: #fff;
}

.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
.module-admin-entry{margin:20rpx 24rpx;padding:26rpx;background:#eafaf1;color:#07c160;border-radius:12rpx;font-size:28rpx}
.page { background: #f4f1eb; color: #1e2925; }
.nav-bar { background: rgba(244,241,235,.97); box-shadow: none; border-bottom: 1rpx solid #e6e0d5; }
.nav-title { color: #1e2925; font-weight: 700; }
.tab-bar { margin: 18rpx 24rpx 0; padding: 6rpx; border: 1rpx solid #e4ddd1; border-radius: 14rpx; background: #fbfaf7; }
.tab-item { padding: 20rpx 0; color: #8b948e; }
.tab-item.active { color: #1d6b57; }
.tab-item.active::after { background: #1d6b57; }
.stats-section { padding: 24rpx; }
.stat-card, .user-item, .post-item { background: #fbfaf7; border: 1rpx solid #e9e3d8; border-radius: 14rpx; box-shadow: 0 7rpx 18rpx rgba(48,55,48,.05); }
.stat-num { color: #1d6b57; }
.module-admin-entry { margin: 20rpx 0; padding: 28rpx; border-radius: 14rpx; background: #1d6b57; color: #fff; box-shadow: 0 8rpx 20rpx rgba(29,107,87,.18); }
.list-section { padding: 20rpx 24rpx; }
.btn-ban.ban, .btn-delete { background: #b76650; }
.btn-ban.unban, .btn-top.active { background: #1d6b57; }
.module-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 30rpx 0 16rpx; color: #1e2925; font-size: 32rpx; font-weight: 700; }
.module-heading text:last-child { color: #9a8d79; font-size: 22rpx; font-weight: 400; }
.module-links { display: flex; flex-wrap: wrap; gap: 16rpx; }
.module-link { position: relative; width: calc((100% - 16rpx) / 2); min-height: 178rpx; box-sizing: border-box; padding: 22rpx; border-radius: 18rpx; overflow: hidden; box-shadow: 0 9rpx 22rpx rgba(48,55,48,.08); }
.module-link:nth-child(3) { width: 100%; min-height: 142rpx; }
.market-link { background: #f0e1cf; color: #754f33; }
.errand-link { background: #dfece5; color: #1d6b57; }
.club-link { background: #e5e4ef; color: #55527b; }
.module-icon { display: block; font-size: 44rpx; opacity: .75; }
.module-name { display: block; margin-top: 18rpx; font-size: 30rpx; font-weight: 700; }
.module-hint { display: block; margin-top: 7rpx; font-size: 22rpx; opacity: .72; }
.module-arrow { position: absolute; right: 20rpx; bottom: 16rpx; font-size: 38rpx; opacity: .55; }
.role-picker { display: inline-block; margin-right: 10rpx; }
.role-control { min-width: 112rpx; padding: 10rpx 12rpx; border: 1rpx solid #c9d7cf; border-radius: 9rpx; color: #1d6b57; background: #e4efe9; text-align: center; font-size: 21rpx; }
.protected-label { color: #a08f7a; font-size: 21rpx; white-space: nowrap; }
.user-action { display: flex; align-items: center; }
.btn-ban { white-space: nowrap; }
