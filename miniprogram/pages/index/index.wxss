.page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.nav-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  display: flex;
  align-items: center;
}

.nav-loc {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.school-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-refresh {
  font-size: 28rpx;
  color: #999;
  margin-left: 12rpx;
}

.search-pill {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.search-text {
  font-size: 26rpx;
  color: #999;
}

/* 四个功能入口 */
.func-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx;
}

.func-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.func-text {
  flex: 1;
}

.func-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.func-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-right: 8rpx;
}

.func-arrow {
  font-size: 20rpx;
  color: #ccc;
}

.func-desc {
  font-size: 22rpx;
  color: #999;
}

.func-emoji {
  font-size: 48rpx;
}

/* 置顶帖子 */
.pinned-section {
  padding: 0 20rpx;
}

.pinned-item {
  display: flex;
  align-items: center;
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.pinned-badge {
  background: #faad14;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pinned-text {
  font-size: 26rpx;
  color: #666;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 集市火文 */
.hot-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.hot-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.hot-fire {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.hot-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hot-item {
  display: flex;
  align-items: center;
}

.hot-rank-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  color: #999;
}

.hot-rank-1 .hot-rank-num {
  background: #ff4d4f;
  color: #fff;
}

.hot-rank-2 .hot-rank-num {
  background: #fa8c16;
  color: #fff;
}

.hot-rank-3 .hot-rank-num {
  background: #faad14;
  color: #fff;
}

.hot-title-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.hot-like-count {
  font-size: 22rpx;
  color: #999;
}

.hot-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* 分类标签栏 */
.cat-tabs {
  white-space: nowrap;
  padding: 20rpx;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
}

.cat-tab.active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

/* 帖子列表 */
.post-list {
  padding: 0 20rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.post-user {
  flex: 1;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.post-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-right: 12rpx;
}

.role-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.post-time {
  font-size: 22rpx;
  color: #999;
}

.post-more {
  font-size: 32rpx;
  color: #ccc;
}

.post-body {
  margin-bottom: 20rpx;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-bottom: 12rpx;
}

.post-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.post-actions {
  display: flex;
  justify-content: flex-end;
}

.action-right {
  display: flex;
  gap: 40rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 28rpx;
}

.action-num {
  font-size: 24rpx;
  color: #999;
}

/* 底部状态 */
.loading-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}

.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 120rpx 0;
}

/* 悬浮发帖按钮 */
.fab {
  position: fixed;
  bottom: 140rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  z-index: 99;
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: 300;
}
