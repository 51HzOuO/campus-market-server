.page{min-height:100vh;background:#f5f6f8;padding:24rpx}.header{height:80rpx;display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:600}.header text:first-child{font-size:52rpx;font-weight:300}.picker{background:#fff;border-radius:12rpx;padding:26rpx 30rpx;margin-bottom:20rpx}.card{background:#fff;border-radius:14rpx;padding:26rpx;margin-bottom:18rpx}.row{display:flex;justify-content:space-between;align-items:center}.title{font-size:31rpx;font-weight:600}.status{font-size:24rpx;color:#999}.actions{margin-top:20rpx}.actions button{margin:0}.empty{text-align:center;color:#999;padding:100rpx 0}
