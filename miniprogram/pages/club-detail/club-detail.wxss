.page{min-height:100vh;background:#f5f6f8;padding:28rpx}.card{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:20rpx}.name{font-size:38rpx;font-weight:700}.desc{font-size:28rpx;color:#555;margin:18rpx 0}.meta{font-size:24rpx;color:#999;margin-bottom:20rpx}.section-title{font-size:30rpx;font-weight:600;margin:20rpx 0}.activity{font-size:25rpx;color:#777}.activity-title{font-size:30rpx;color:#222;font-weight:600;margin-bottom:10rpx}
.page { background: #f4f1eb; padding: 34rpx 20rpx; color: #1e2925; }
.card { background: #fbfaf7; border: 1rpx solid #e9e3d8; border-radius: 14rpx; box-shadow: 0 8rpx 22rpx rgba(48,55,48,.06); }
.name { color: #1e2925; }
.desc { color: #65706a; line-height: 1.55; }
.meta { color: #a08f7a; }
.section-title { color: #1e2925; }
.activity { border-left: 6rpx solid #1d6b57; }
