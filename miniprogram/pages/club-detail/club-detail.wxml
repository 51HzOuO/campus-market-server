<view class="page"><view class="card"><view class="name">{{club.name}}</view><view class="desc">{{club.description}}</view><view class="meta">联系方式：{{club.contact || '未公开'}}　成员 {{club.memberCount || 0}} 人</view><button size="mini" type="primary" bindtap="join">{{joined ? '退出社团' : '加入社团'}}</button></view><view class="section-title">近期活动</view><view class="card activity" wx:for="{{activities}}" wx:key="id"><view class="activity-title">{{item.title}}</view><view>{{item.location}} · {{item.startTime}}</view></view><button bindtap="activities">查看全部活动</button></view>
