.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-back {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.nav-placeholder-right {
  flex-shrink: 0;
  width: 60rpx;
}

/* ========== 通用段落 ========== */
.section {
  background: #fff;
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
}

.section:first-of-type {
  margin-top: 0;
}

.section-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

/* ========== 模块选择 ========== */
.module-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.module-btn {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #555;
  background: #f5f5f5;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.module-btn.selected {
  color: #2DBE9A;
  background: #eafaf5;
  border-color: #2DBE9A;
  font-weight: 500;
}

/* ========== 标题输入 ========== */
.title-input {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  height: 80rpx;
  line-height: 80rpx;
}

.placeholder {
  color: #ccc;
}

/* ========== 内容输入 ========== */
.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 12rpx;
}

.word-count.warn {
  color: #ff6b6b;
}

/* ========== 图片上传 ========== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.add-icon {
  font-size: 56rpx;
  color: #ccc;
  line-height: 1;
  margin-bottom: 4rpx;
}

.add-text {
  font-size: 22rpx;
  color: #bbb;
}

/* ========== 底部提示 ========== */
.footer-tip {
  text-align: center;
  padding: 40rpx 24rpx 20rpx;
  font-size: 22rpx;
  color: #bbb;
}

.link {
  color: #2DBE9A;
}

/* ========== 底部固定发布按钮 ========== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
}

.bottom-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #bbb;
  background: #e8e8e8;
  border-radius: 44rpx;
  transition: all 0.2s;
}

.bottom-btn.active {
  color: #fff;
  background: #2DBE9A;
}
