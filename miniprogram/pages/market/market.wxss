.page{min-height:100vh;background:#f4f1eb;padding:28rpx 24rpx 140rpx;box-sizing:border-box}.search-row{display:flex;gap:16rpx}.search-input{flex:1;background:#fbfaf7;border:1rpx solid #e5dfd3;border-radius:10rpx;padding:0 28rpx;height:76rpx;box-sizing:border-box}.search-btn{height:76rpx;line-height:76rpx;border-radius:10rpx;background:#1d6b57;color:#fff;font-size:28rpx;padding:0 30rpx}.category-row{white-space:nowrap;margin:24rpx -24rpx;padding:0 24rpx}.category{display:inline-block;padding:14rpx 26rpx;margin-right:12rpx;border-radius:8rpx;background:#fbfaf7;color:#65706a;font-size:26rpx}.category.active{background:#e4efe9;color:#1d6b57}.item-card{display:flex;background:#fbfaf7;border:1rpx solid #e9e3d8;border-radius:10rpx;padding:20rpx;margin-bottom:18rpx;box-shadow:0 5rpx 16rpx rgba(48,55,48,.04)}.item-cover{width:190rpx;height:190rpx;border-radius:8rpx;flex-shrink:0}.item-cover-empty{display:flex;align-items:center;justify-content:center;background:#ebe7df;color:#8b948e;font-size:24rpx}.item-main{padding-left:22rpx;min-width:0;display:flex;flex-direction:column;flex:1}.item-title{font-size:30rpx;font-weight:600;color:#1e2925;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item-description{color:#65706a;font-size:25rpx;line-height:1.45;margin:12rpx 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.item-meta,.seller{display:flex;justify-content:space-between;color:#8a948d;font-size:23rpx}.price{font-size:32rpx;color:#a46639;font-weight:600}.state{text-align:center;color:#8a948d;padding:28rpx;font-size:24rpx}.publish-btn{position:fixed;bottom:32rpx;left:50%;transform:translateX(-50%);width:80%;height:84rpx;line-height:84rpx;background:#1d6b57;color:#fff;border-radius:10rpx;font-size:30rpx;z-index:5;box-shadow:0 8rpx 18rpx rgba(29,107,87,.22)}
.search-row { gap: 12rpx; }
.search-input { height: 82rpx; border-radius: 14rpx; background: #fbfaf7; }
.search-btn { height: 82rpx; line-height: 82rpx; border-radius: 14rpx; }
.category { border-radius: 24rpx; border: 1rpx solid #e5dfd3; }
.category.active { background: #1d6b57; color: #fff; border-color: #1d6b57; }
.item-card { padding: 22rpx; border-radius: 14rpx; box-shadow: 0 8rpx 22rpx rgba(48,55,48,.06); }
.item-cover { width: 198rpx; height: 198rpx; border-radius: 10rpx; }
.publish-btn { width: calc(100% - 48rpx); bottom: 36rpx; border-radius: 14rpx; }
