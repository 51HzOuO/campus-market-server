.page{min-height:100vh;background:#f5f6f8;padding:24rpx 24rpx 140rpx;box-sizing:border-box}.search-row{display:flex;gap:16rpx}.search-input{flex:1;background:#fff;border-radius:40rpx;padding:0 28rpx;height:76rpx;box-sizing:border-box}.search-btn{height:76rpx;line-height:76rpx;border-radius:40rpx;background:#2dbe9a;color:#fff;font-size:28rpx;padding:0 30rpx}.category-row{white-space:nowrap;margin:24rpx -24rpx;padding:0 24rpx}.category{display:inline-block;padding:14rpx 26rpx;margin-right:12rpx;border-radius:30rpx;background:#fff;color:#666;font-size:26rpx}.category.active{background:#dff8ef;color:#159a78}.item-card{display:flex;background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:18rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.03)}.item-cover{width:190rpx;height:190rpx;border-radius:12rpx;flex-shrink:0}.item-cover-empty{display:flex;align-items:center;justify-content:center;background:#f0f1f2;color:#aaa;font-size:24rpx}.item-main{padding-left:22rpx;min-width:0;display:flex;flex-direction:column;flex:1}.item-title{font-size:30rpx;font-weight:600;color:#222;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item-description{color:#777;font-size:25rpx;line-height:1.45;margin:12rpx 0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.item-meta,.seller{display:flex;justify-content:space-between;color:#999;font-size:23rpx}.price{font-size:32rpx;color:#ef6a43;font-weight:600}.state{text-align:center;color:#aaa;padding:28rpx;font-size:24rpx}.publish-btn{position:fixed;bottom:32rpx;left:50%;transform:translateX(-50%);width:80%;height:84rpx;line-height:84rpx;background:#2dbe9a;color:#fff;border-radius:44rpx;font-size:30rpx;z-index:5}
