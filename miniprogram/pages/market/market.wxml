<view class="page">
  <view class="search-row">
    <input class="search-input" placeholder="搜索商品" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="search" />
    <button class="search-btn" bindtap="search">搜索</button>
  </view>
  <scroll-view class="category-row" scroll-x>
    <view wx:for="{{categories}}" wx:key="index" class="category {{categoryIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectCategory">{{item}}</view>
  </scroll-view>
  <view class="item-list">
    <view class="item-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <image wx:if="{{item.cover}}" class="item-cover" src="{{item.cover}}" mode="aspectFill" />
      <view wx:else class="item-cover item-cover-empty">暂无图片</view>
      <view class="item-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-description">{{item.description}}</text>
        <view class="item-meta"><text class="price">¥{{item.price}}</text><text>{{item.category || '其他'}}</text></view>
        <text class="seller">{{item.sellerNickname || '匿名用户'}} · {{item.location || '校内面交'}}</text>
      </view>
    </view>
  </view>
  <view class="state" wx:if="{{loading}}">加载中...</view>
  <view class="state" wx:if="{{!loading && !items.length}}">暂无在售商品</view>
  <view class="state" wx:if="{{!loading && noMore && items.length}}">— 没有更多了 —</view>
  <button class="publish-btn" bindtap="goPublish">发布商品</button>
</view>
