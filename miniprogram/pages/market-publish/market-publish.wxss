.page{min-height:100vh;background:#f5f6f8;padding-bottom:40rpx}.section{background:#fff;margin-bottom:16rpx;padding:26rpx 28rpx}.title{font-size:32rpx;font-weight:600;height:70rpx}.description{width:100%;min-height:220rpx;line-height:1.6;font-size:28rpx}.count{display:block;text-align:right;color:#aaa;font-size:22rpx}.row{display:flex;align-items:center;justify-content:space-between;font-size:28rpx}.price{width:300rpx;text-align:right;color:#ef6a43}.label{display:block;color:#666;font-size:25rpx;margin-bottom:18rpx}.categories{display:flex;flex-wrap:wrap;gap:16rpx}.category{padding:14rpx 24rpx;border-radius:30rpx;background:#f3f3f3;color:#666;font-size:25rpx}.category.active{background:#dff8ef;color:#159a78}.contact{margin-top:30rpx}.images{display:flex;flex-wrap:wrap;gap:16rpx}.image-wrap,.image-wrap image,.add{width:190rpx;height:190rpx}.image-wrap{position:relative}.image-wrap image{border-radius:10rpx}.image-wrap text{position:absolute;right:-8rpx;top:-12rpx;width:38rpx;height:38rpx;line-height:34rpx;border-radius:50%;text-align:center;background:rgba(0,0,0,.55);color:#fff;font-size:28rpx}.add{border:2rpx dashed #ccc;border-radius:10rpx;display:flex;align-items:center;justify-content:center;font-size:60rpx;color:#bbb}.submit{margin:42rpx 28rpx;height:86rpx;line-height:86rpx;border-radius:44rpx;background:#2dbe9a;color:#fff;font-size:30rpx}
