.page{min-height:100vh;background:#f5f6f8;padding:28rpx}.section-title{font-size:32rpx;font-weight:600;margin:10rpx 0 18rpx}.card{background:#fff;border-radius:14rpx;padding:26rpx;margin-bottom:18rpx}.title{font-size:31rpx;font-weight:600;margin-bottom:12rpx}.meta{font-size:24rpx;color:#999;margin-top:14rpx}.activity-state{display:inline-block;color:#07c160;font-size:24rpx;margin:16rpx 18rpx 0 0}.page input,.page textarea{box-sizing:border-box;width:100%;background:#fff;border-radius:12rpx;padding:22rpx;margin-bottom:18rpx}.page textarea{height:220rpx}
.page { background: #f4f1eb; padding: 30rpx 20rpx 70rpx; color: #1e2925; }.form-card { background: #fbfaf7; border: 1rpx solid #e9e3d8; border-radius: 14rpx; padding: 26rpx; box-shadow: 0 8rpx 22rpx rgba(48,55,48,.05); }.activity-input { display: block; width: 100%; min-width: 0; height: 86rpx; box-sizing: border-box; padding: 20rpx; background: #f4f1eb !important; border: 1rpx solid #e5dfd3; border-radius: 12rpx; }.activity-textarea { height: 220rpx; }.form-card button { margin-top: 8rpx; background: #1d6b57; border-radius: 12rpx; }
