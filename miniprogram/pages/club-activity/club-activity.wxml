<view class="page"><view class="section-title">活动列表</view><view class="card" wx:for="{{activities}}" wx:key="id"><view class="title">{{item.title}}</view><view>{{item.content}}</view><view class="meta">{{item.startTime}} · {{item.location}}</view><button size="mini" type="primary" data-id="{{item.id}}" bindtap="joinActivity">报名活动</button></view><view class="section-title">负责人发布活动</view><input placeholder="活动标题" data-field="title" bindinput="input"/><textarea placeholder="活动内容" data-field="content" bindinput="input"/><input type="text" placeholder="开始时间，如 2026-10-01 18:00:00" data-field="startTime" bindinput="input"/><input placeholder="地点" data-field="location" bindinput="input"/><input type="number" placeholder="人数上限（可选）" data-field="maxParticipants" bindinput="input"/><button type="primary" bindtap="submit">提交活动审核</button></view>
