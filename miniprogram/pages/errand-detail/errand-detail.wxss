.page{min-height:100vh;background:#f5f6f8;padding:24rpx 24rpx 150rpx;box-sizing:border-box;color:#222}.loading{text-align:center;color:#999;padding:100rpx}.card{background:#fff;border-radius:18rpx;padding:26rpx 24rpx;margin-bottom:18rpx}.title-line{display:flex;align-items:center}.title{font-size:36rpx;font-weight:600;flex:1;line-height:1.4}.urgent{font-size:21rpx;color:#f05b4f;border:1rpx solid #f05b4f;border-radius:6rpx;padding:2rpx 8rpx;margin-right:10rpx}.status{font-size:24rpx;color:#07c160;margin-left:12rpx}.desc{display:block;color:#666;font-size:28rpx;line-height:1.6;margin-top:18rpx}.head-card .price{font-size:50rpx;color:#f06a32;font-weight:600;margin-top:24rpx}.time{display:block;color:#aaa;font-size:23rpx;margin-top:12rpx}.card-title{font-size:29rpx;font-weight:600;margin-bottom:22rpx}.route{display:flex;align-items:flex-start;font-size:28rpx;line-height:1.6}.route>view{display:flex;flex-direction:column}.route-label{color:#999;font-size:23rpx}.dot{width:16rpx;height:16rpx;border-radius:50%;margin:10rpx 18rpx 0 4rpx;flex:none}.dot.from{background:#07c160}.dot.to{background:#4c8dff}.line{height:24rpx;border-left:2rpx dashed #ccd3dc;margin-left:11rpx}.measure{border-top:1rpx solid #f2f2f2;margin-top:22rpx;padding-top:18rpx;color:#999;font-size:24rpx}.info-row{display:flex;justify-content:space-between;padding:14rpx 0;color:#555;font-size:27rpx}.info-row text:first-child{color:#999}.audit-tip{padding:20rpx;color:#b07b22;background:#fff8e7;border-radius:12rpx;font-size:25rpx}.audit-tip.rejected{color:#c74c4c;background:#fff0ef}.bottom{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx;box-shadow:0 -2rpx 12rpx rgba(0,0,0,.06)}.action{flex:1;height:84rpx;line-height:84rpx;border-radius:42rpx;font-size:29rpx}.action.primary{background:#07c160;color:#fff}.action.cancel{color:#e15b52;background:#fff;border:1rpx solid #e15b52}
