<view class="page">

  <!-- 顶部发帖按钮 -->
  <view class="top-bar">
    <view class="fab-top" bindtap="goCreate">
      <text class="fab-icon">+</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <view class="msg-section">
    <view class="section-title">消息通知</view>
    <view class="msg-list" wx:if="{{messages.length > 0}}">
      <view class="msg-item" wx:for="{{messages}}" wx:key="id" bindtap="goPost" data-id="{{item.postId}}">
        <image class="msg-avatar" src="{{item.avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="msg-content">
          <text class="msg-text">{{item.text}}</text>
          <text class="msg-time">{{item.timeAgo}}</text>
        </view>
        <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
      </view>
    </view>
    <view class="empty" wx:if="{{messages.length === 0}}">
      <text>暂无消息</text>
    </view>
  </view>

  <!-- 我的帖子数据 -->
  <view class="stats-section">
    <view class="section-title">我的帖子数据</view>
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-num">{{stats.postCount}}</text>
        <text class="stat-label">发布帖子</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{stats.totalLikes}}</text>
        <text class="stat-label">总点赞数</text>
      </view>
      <view class="stat-card">
        <text class="stat-num">{{stats.totalComments}}</text>
        <text class="stat-label">总评论数</text>
      </view>
    </view>
  </view>

</view>
