.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 顶部发帖按钮 ========== */
.top-bar {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 10rpx;
}

.fab-top {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2DBE9A;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(45, 190, 154, 0.4);
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ========== 通用段落标题 ========== */
.section-title {
  font-size: 26rpx;
  color: #999;
  padding: 24rpx 24rpx 12rpx;
}

/* ========== 消息列表 ========== */
.msg-section {
  background: #fff;
  margin: 0 0 16rpx;
}

.msg-list {
  padding: 0 24rpx;
}

.msg-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
}

.msg-item:last-child {
  border-bottom: none;
}

.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #e8e8e8;
}

.msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.msg-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 6rpx;
}

.msg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF4D4F;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ========== 数据统计 ========== */
.stats-section {
  background: #fff;
  margin: 0 0 16rpx;
}

.stats-row {
  display: flex;
  padding: 10rpx 24rpx 30rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
