.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ========== 自定义导航栏 ========== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}

.nav-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}

.nav-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.icon-loc {
  font-size: 32rpx;
  margin-right: 6rpx;
}

.school-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.icon-arrow-down {
  font-size: 20rpx;
  color: #999;
  margin-left: 4rpx;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 60rpx;
  background: #f2f2f2;
  border-radius: 30rpx;
  padding: 0 24rpx;
}

.icon-search {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: #999;
}

/* ========== 功能入口 (2x2) ========== */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 0;
  gap: 20rpx;
}

.func-card {
  width: calc(50% - 10rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.func-left {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.func-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 6rpx;
}

.func-desc {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.func-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.func-icon {
  font-size: 44rpx;
  margin-right: 8rpx;
}

.func-arrow {
  font-size: 36rpx;
  color: #ccc;
  font-weight: 300;
}

/* ========== 置顶区 ========== */
.section {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.pinned-card {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.pinned-card:last-child {
  border-bottom: none;
}

.pinned-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: #FF8C00;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 16rpx;
}

.pinned-text {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 分类标签栏 ========== */
.cat-tabs {
  display: flex;
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 24rpx;
  margin-top: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 32rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  transition: all 0.25s;
}

.cat-tab.active {
  background: #222;
  color: #fff;
  font-weight: 500;
}

/* ========== 帖子卡片 ========== */
.post-list {
  padding: 0 24rpx;
}

.post-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-top {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 18rpx;
  background: #e8e8e8;
}

.post-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.post-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-right: 10rpx;
}

.role-badge {
  font-size: 20rpx;
  color: #fff;
  background: #4A90D9;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
}

.post-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.post-content {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all;
}

.post-bottom {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-item {
  display: flex;
  align-items: center;
  margin-left: 36rpx;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.action-num {
  font-size: 24rpx;
  color: #999;
}

/* ========== 底部状态 ========== */
.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #ccc;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

/* ========== 悬浮发帖按钮 ========== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.4);
  z-index: 99;
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
