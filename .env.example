# Copy these values into the deployment environment or a local .env file.
# Never commit the file containing real values.
DB_URL=jdbc:mysql://localhost:3306/campus_market?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=campus_market_app
DB_PASSWORD=replace-with-a-secret
WX_APP_ID=replace-with-wechat-app-id
WX_APP_SECRET=replace-with-wechat-app-secret
# Optional HTTPS endpoint for deployments that require an approved proxy.
# WECHAT_API_URL=https://api.weixin.qq.com/sns/jscode2session

# CloudBase production profile (use these instead of DB_* when the managed
# MySQL binding supplies MYSQL_ADDRESS, MYSQL_USERNAME, and MYSQL_PASSWORD).
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_USERNAME=campus_market_app
MYSQL_PASSWORD=replace-with-a-secret
MYSQL_DATABASE=campus_market
